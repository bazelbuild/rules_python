load("@rules_python//python:py_binary.bzl", "py_binary")

exports_files([
    "pkg-1.0-py3-none-any.whl",
    "wheel.sha256",
    "modify_pkg.patch",
])

[
    py_binary(
        name = name,
        srcs = ["main.py"],
        legacy_create_init = 0,
        main = "main.py",
        deps = ["@{}//:pkg".format(name)],
    )
    for name in [
        "plain",
        "patched",
        "nonmatching",
        "provided",
        "provided_patched",
    ]
]
