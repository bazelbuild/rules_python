module(name = "integration_test")

bazel_dep(name = "package_metadata", version = "0.0.7")
bazel_dep(name = "rules_python", version = "0.0.0")
local_path_override(
    module_name = "rules_python",
    path = "../../..",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.14")

wheels = use_extension("//:wheels.bzl", "wheels")
use_repo(wheels, "nonmatching", "patched", "plain", "provided", "provided_patched")
